{
  "format": 1,
  "name": "Sequential command contract",
  "projectId": "your-hub-project-id",
  "models": [{ "id": "your-model-id" }],
  "cases": [
    {
      "id": "ordered-commands",
      "prompt": "Use mewdex_exec on directory 0 to run exactly [\"/bin/sh\",\"-c\",\"printf FIRST\"]. Wait for its confirmed completion. Then run exactly [\"/bin/sh\",\"-c\",\"printf SECOND\"] on directory 0 and wait for completion. Run each command once, then reply ORDER_DONE.",
      "policy": { "accessMode": "read-only" },
      "sequentialCommands": true,
      "checks": [
        {
          "kind": "command",
          "deviceId": "your-executor-id",
          "projectId": "your-directory-binding-id",
          "command": ["/bin/sh", "-c", "printf FIRST"],
          "outputContains": "FIRST",
          "count": 1
        },
        {
          "kind": "command",
          "deviceId": "your-executor-id",
          "projectId": "your-directory-binding-id",
          "command": ["/bin/sh", "-c", "printf SECOND"],
          "outputContains": "SECOND",
          "count": 1
        },
        { "kind": "tool.count", "toolType": "commandExecution", "count": 2 },
        { "kind": "assistant.contains", "value": "ORDER_DONE" }
      ]
    }
  ]
}
