{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MewDex",
  "version": "0.1.13-preview.20261110",
  "identifier": "app.mewdex.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:app",
    "frontendDist": "../dist-app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MewDex",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost https: wss: http: ws:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
