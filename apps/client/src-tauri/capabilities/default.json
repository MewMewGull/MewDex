{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Input client window; HTTPS links and loopback Hub pages open in the system browser",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    { "identifier": "opener:allow-open-url", "allow": [
      { "url": "https://*" },
      { "url": "http://127.0.0.1:*" },
      { "url": "http://127.0.0.1/*" },
      { "url": "http://localhost:*" },
      { "url": "http://localhost/*" },
      { "url": "http://[[]::1]:*" },
      { "url": "http://[[]::1]/*" }
    ] }
  ]
}
