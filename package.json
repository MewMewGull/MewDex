{
  "name": "mewdex",
  "version": "0.1.13-preview.20261110",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MewMewGull/MewDex.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mewdex/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:ui": "npm run build --workspace @mewdex/client",
    "test:sdk": "npm run test --workspace @mewdex/sdk",
    "test:client": "npm run test --workspace @mewdex/client",
    "test:release": "node --test scripts/test/release.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "version:app": "node scripts/set-app-version.mjs",
    "package:services": "node scripts/package-components.mjs",
    "package:hub": "node scripts/package-components.mjs --component=hub",
    "package:executor": "node scripts/package-components.mjs --component=executor",
    "package:web": "node scripts/package-components.mjs --component=web",
    "package:channel": "node scripts/package-components.mjs --component=channel",
    "build:app:windows": "powershell -NoProfile -File scripts/build-desktop-development.ps1",
    "package:app:windows": "python scripts/export-windows-development.py"
  },
  "devDependencies": {
    "prettier": "3.5.3"
  }
}
