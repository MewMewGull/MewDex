{
  "name": "mewdex",
  "version": "0.1.1-preview.20261104",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MewMewGull/MewDex.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mewdex/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:ui": "npm run build --workspace @mewdex/client",
    "test:sdk": "npm run test --workspace @mewdex/sdk",
    "test:client": "npm run test --workspace @mewdex/client",
    "test:release": "node --test scripts/test/release.test.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "version:app": "node scripts/set-app-version.mjs"
  },
  "devDependencies": {
    "prettier": "3.5.3"
  }
}
