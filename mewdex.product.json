{
  "schemaVersion": 1,
  "components": {
    "input-terminal": {
      "name": "Input Terminal",
      "label": "输入终端",
      "sources": [
        "apps/client/src/input-terminal"
      ],
      "purpose": "输入任务、继续对话、阅读结果和响应交互"
    },
    "execute-terminal": {
      "name": "Execute Terminal",
      "label": "执行终端",
      "sources": [
        "internal/executor",
        "internal/engine"
      ],
      "purpose": "接收 Hub 指令，在本机项目目录中执行命令和回传文件"
    },
    "hub": {
      "name": "Hub",
      "label": "管理终端",
      "sources": [
        "internal/hub",
        "internal/transport"
      ],
      "purpose": "管理项目目录组、模型账号、会话、执行调度和网络身份"
    },
    "hub-controller": {
      "name": "Hub Controller",
      "label": "管理终端的管理器",
      "sources": [
        "apps/client/src/hub-controller"
      ],
      "purpose": "通过 Hub 管理网络账号、项目、授权和在线 APP 的消息渠道"
    },
    "message-connector": {
      "name": "Message Connector",
      "label": "消息渠道连接器",
      "sources": [
        "internal/inputbridge",
        "internal/messaging"
      ],
      "purpose": "随桌面 APP 连接 QQ、微信和飞书，处理消息并经普通输入接口提交给 Hub"
    },
    "executor-panel": {
      "name": "Executor Control Panel",
      "label": "执行端网页控制面板",
      "sources": [
        "internal/executorpanel"
      ],
      "purpose": "配置独立执行端、Hub 配对、服务启停和本机目录"
    }
  },
  "platforms": {
    "windows": {
      "name": "Windows",
      "family": "desktop",
      "architectures": [
        "x64",
        "arm64"
      ],
      "components": [
        "input-terminal",
        "hub-controller",
        "message-connector"
      ],
      "installerExtensions": [
        ".exe",
        ".msi"
      ],
      "installation": "安装 APP 后连接独立部署的 Hub。消息渠道由 APP 保持连接。"
    },
    "macos": {
      "name": "macOS",
      "family": "desktop",
      "architectures": [
        "x64",
        "arm64"
      ],
      "components": [
        "input-terminal",
        "hub-controller",
        "message-connector"
      ],
      "installerExtensions": [
        ".dmg",
        ".pkg"
      ],
      "installation": "安装 APP 后连接独立部署的 Hub。消息渠道由 APP 保持连接。"
    },
    "linux": {
      "name": "Linux Desktop",
      "family": "desktop",
      "architectures": [
        "x64",
        "arm64"
      ],
      "components": [
        "input-terminal",
        "hub-controller",
        "message-connector"
      ],
      "installerExtensions": [
        ".AppImage",
        ".deb",
        ".rpm"
      ],
      "installation": "安装 APP 后连接独立部署的 Hub。消息渠道由 APP 保持连接。"
    },
    "android": {
      "name": "Android",
      "family": "mobile",
      "architectures": [
        "arm64"
      ],
      "components": [
        "input-terminal",
        "hub-controller"
      ],
      "installerExtensions": [
        ".apk"
      ],
      "installation": "安装 APP 后连接独立部署的 Hub。"
    },
    "ios": {
      "name": "iOS / iPadOS",
      "family": "mobile",
      "architectures": [
        "arm64"
      ],
      "components": [
        "input-terminal",
        "hub-controller"
      ],
      "installerExtensions": [
        ".ipa"
      ],
      "installation": "安装 APP 后连接独立部署的 Hub。"
    }
  },
  "distributions": {
    "app": {
      "name": "APP",
      "components": [
        "input-terminal",
        "hub-controller",
        "message-connector"
      ]
    },
    "web": {
      "name": "Web Input",
      "components": [
        "input-terminal",
        "hub-controller"
      ]
    },
    "hub": {
      "name": "Hub",
      "components": [
        "hub"
      ]
    },
    "executor": {
      "name": "Executor",
      "components": [
        "execute-terminal",
        "executor-panel"
      ]
    }
  }
}
